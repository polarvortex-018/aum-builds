{
  "version": 2,
  "routes": [
    {
      "src": "/style.css",
      "headers": { "Content-Type": "text/css" },
      "dest": "/style.css"
    },
    {
      "src": "/script.js",
      "headers": { "Content-Type": "application/javascript" },
      "dest": "/script.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
